<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SatvikScan" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- App background color so window never flashes dark/black -->
        <item name="android:windowBackground">#FAF9F9</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.SatvikScan.Starting" parent="Theme.SplashScreen">
        <!-- SplashScreen background color (without android: prefix for API < 31 compatibility) -->
        <item name="windowSplashScreenBackground">#FEFAE9</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_1</item>

        <!-- Theme to transition to after splash screen completes -->
        <item name="postSplashScreenTheme">@style/Theme.SatvikScan</item>
    </style>
</resources>